# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
# Thứ tự ưu tiên khi resolve (lấy giá trị khác rỗng đầu tiên):
#   api_base : LLM_API_BASE  >  <PROVIDER>_API_BASE  >  default có sẵn trong code
#   api_key  : LLM_API_KEY   >  <PROVIDER>_API_KEY   >  OPENAI_API_KEY
#   model    : LLM_MODEL_<ROLE>  >  LLM_MODEL  >  MODEL_NAME  >  default theo provider
#
# Chọn provider: openai | gemini | groq | mimo | anthropic | <tên tuỳ ý + LLM_API_BASE>
# Alias: google -> gemini, claude -> anthropic
LLM_PROVIDER=openai

# --- Override generic (dùng cho MỌI endpoint OpenAI-compatible) ---
# Để trống = dùng default của LLM_PROVIDER bên dưới.
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# --- Model riêng cho từng bước (để trống = dùng LLM_MODEL/MODEL_NAME chung) ---
# enrich = sinh tên nghiệp vụ cho schema; metric = đề xuất business metric
LLM_MODEL_ENRICH=
LLM_MODEL_METRIC=

# --- Wire protocol: để trống = suy ra từ LLM_PROVIDER ---
# Chỉ set khi endpoint không phải OpenAI-compatible. Hỗ trợ: openai | anthropic
# LLM_PROTOCOL=anthropic

# 1. Nếu dùng OpenAI:
OPENAI_API_KEY=sk-your-openai-key-here
MODEL_NAME=gpt-4o-mini

# 2. Nếu dùng Google Gemini (OpenAI-compatible):
# LLM_PROVIDER=gemini
# GOOGLE_API_KEY=AIzaSy...your-google-gemini-key...
# MODEL_NAME=gemini-1.5-flash

# 3. Nếu dùng Groq (Tốc độ siêu nhanh, miễn phí):
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...your-groq-key...
# MODEL_NAME=llama-3.3-70b-versatile

# 4. Nếu dùng MiMo:
# LLM_PROVIDER=mimo
# MIMO_API_KEY=your-mimo-key-here
# MODEL_NAME=mimo-v1

# 5. Custom / self-host (vLLM, Ollama, LM Studio, proxy nội bộ, DeepSeek, OpenRouter...)
#    Không cần sửa code — chỉ cần 3 biến generic:
# LLM_PROVIDER=custom
# LLM_API_BASE=http://localhost:8000/v1
# LLM_API_KEY=sk-local          # endpoint localhost có thể để trống
# LLM_MODEL=qwen2.5-32b-instruct

# 6. Nếu dùng Anthropic API gốc (KHÔNG phải OpenAI-compatible):
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...your-key...
# MODEL_NAME=claude-sonnet-5
# ANTHROPIC_API_BASE=https://api.anthropic.com   # mặc định, thường không cần set

# 7. Chỉ đổi riêng base URL của 1 provider (ví dụ đi qua proxy nội bộ).
#    Mặc định là endpoint chính thức, thường không cần set:
# OPENAI_API_BASE=https://api.openai.com/v1
# MIMO_API_BASE=https://api.xiaomimimo.com/v1
# GROQ_API_BASE=https://api.groq.com/openai/v1
# GOOGLE_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/

LLM_TEMPERATURE=0.0

# ---- Isolated AI Judge Configuration ----
# Chỉ bắt buộc khi chạy --engine hybrid --judge.
# Provider, model và API key đều phải khác Agent; không có fallback credential.
JUDGE_LLM_PROVIDER=groq
JUDGE_API_KEY=gsk-your-separate-judge-key-here
JUDGE_MODEL_NAME=llama-3.3-70b-versatile
# Tuỳ chọn với provider đã biết; bắt buộc với custom provider.
# JUDGE_API_BASE=https://api.groq.com/openai/v1
# Để trống = suy ra từ provider; hỗ trợ openai | anthropic.
# JUDGE_LLM_PROTOCOL=

# ---- Security ----
# Fernet key for encrypting Target DB connection URLs
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

# ---- Database ----
# Dev (Docker Compose): sử dụng container postgres trong docker-compose.dev.yml
DATABASE_URL=postgresql+asyncpg://dev:devpassword@localhost:5432/semantic_layer_dev
# Prod: thay bằng connection string thật
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ---- Target Database & Data Import (Testing & Seeding) ----
# PostgreSQL Example:
TARGET_DATABASE_URL=postgresql://dev:devpassword@localhost:5432/ecommerce_db
# MySQL Example:
# TARGET_DATABASE_URL=mysql+pymysql://root:devpassword@localhost:3306/ecommerce_db
CSV_DATA_DIR=path/to/csv/data

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-api-key-here
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
