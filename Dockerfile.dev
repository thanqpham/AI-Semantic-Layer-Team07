# ---- Dev image ----
# Single-stage, lightweight — dùng với docker-compose.dev.yml
FROM python:3.11-slim

WORKDIR /app

# Cài system deps tối thiểu
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Cài Python dev dependencies (bao gồm pytest, ruff, watchfiles...)
COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt

# Code được mount qua volume — không cần COPY ở đây
# (bind mount trong docker-compose.dev.yml ghi đè thư mục /app)

EXPOSE 8000

# --reload: tự restart khi code thay đổi
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--reload-dir", "src"]
